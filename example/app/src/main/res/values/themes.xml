<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.MaestraAndroidSdkExample" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Status bar: green background, white icons -->
        <item name="android:statusBarColor">@color/maestra_green_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>

        <!-- Primary — Maestra dark green for good contrast on white -->
        <item name="colorPrimary">@color/maestra_green_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/maestra_lime_soft</item>
        <item name="colorOnPrimaryContainer">@color/maestra_green_deep</item>

        <!-- Secondary — Maestra accent green -->
        <item name="colorSecondary">@color/maestra_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/maestra_lime_soft</item>
        <item name="colorOnSecondaryContainer">@color/maestra_green_deep</item>

        <!-- Tertiary — Maestra lime -->
        <item name="colorTertiary">@color/maestra_lime</item>
        <item name="colorOnTertiary">@color/maestra_ink</item>

        <!-- Surfaces -->
        <item name="android:colorBackground">@color/maestra_background</item>
        <item name="colorSurface">@color/maestra_surface</item>
        <item name="colorOnSurface">@color/maestra_text_primary</item>
        <item name="colorSurfaceVariant">@color/maestra_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/maestra_text_secondary</item>

        <!-- Outline for borders -->
        <item name="colorOutline">@color/maestra_outline</item>
        <item name="colorOutlineVariant">@color/maestra_surface_variant</item>
    </style>

    <style name="Theme.MaestraAndroidSdkExample" parent="Base.Theme.MaestraAndroidSdkExample" />

    <style name="TextAppearance.MaestraToolbar" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
